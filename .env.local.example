# Copy this file to .env.local and fill in real values. Never commit
# .env.local itself -- it's already gitignored.

# --- Stripe (existing single-tenant shop) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Stripe Connect (Phase 3 -- artist payouts) ---
# From the webhook endpoint's settings once you add
# https://<your-domain>/api/webhooks/connect in the Stripe Dashboard.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Database (Postgres -- Neon via Vercel's Storage tab is the easy path) ---
# Vercel sets DATABASE_URL or POSTGRES_URL automatically once connected;
# locally, run `vercel env pull .env.local` to copy it down.
DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# --- Auth (magic-link sign-in, lib/auth.js) ---
# Any long random string -- used to salt session/login-token hashes.
# Rotating it instantly invalidates every existing session and login link.
AUTH_TOKEN_SALT=

# --- Email (Resend -- backup download emails + magic-link emails) ---
# The shared onboarding@resend.dev address can only email your own Resend
# account address. Verify a real sending domain in Resend to email actual
# customers/artists -- see RESEND_FROM_EMAIL below.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Legacy single-tenant-only (retired once the platform migration lands) ---
ABRACADABRA_KEEPER_PASSCODE=
ANTHROPIC_API_KEY=
# ANTHROPIC_ORACLE_MODEL=
IP_HASH_SALT=
